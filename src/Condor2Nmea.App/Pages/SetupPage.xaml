<Page x:Class="Condor2Nmea.App.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Condor2Nmea.App.Controls"
      Title="Einrichtung"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,5,0,6" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="ActionRow" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,36" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Einrichtung" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Fünf Schritte, dann fliegt Condor mit deinem Flugcomputer. Erledigte Schritte werden automatisch abgehakt." />

            <!-- ================================================= 1 com0com -->
            <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:StepBadge Number="1" IsDone="{Binding ComPort.IsUsable}" VerticalAlignment="Top" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Treiber com0com installieren" />
                        <TextBlock Style="{StaticResource StepText}">
                            <Run Text="Condor gibt NMEA nur über einen COM-Port aus. Den virtuellen Port stellt der kostenlose Treiber com0com bereit. Wichtig ist die" />
                            <Run Text="signierte Version 2.2.2.0" FontWeight="SemiBold" />
                            <Run Text="– die neuere Version 3.0 wird von Windows 10/11 nicht geladen." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource StepText}" Margin="0,8,0,0">
                            <Run Text="1. Herunterladen:" FontWeight="SemiBold" />
                            <Run Text="{Binding ComPort.RecommendedPackage, Mode=OneWay}" />
                            <LineBreak />
                            <Run Text="2. ZIP entpacken und setup.exe starten." />
                            <LineBreak />
                            <Run Text="3. Bei den Komponenten „CNCA0 ↔ CNCB0“ und „COM# ↔ COM#“ die Häkchen entfernen – den Port legt Condor2NMEA selbst an." />
                            <LineBreak />
                            <Run Text="4. Die Windows-Sicherheitsabfrage zur Treiberinstallation bestätigen, dann „Erneut prüfen“." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ComPort.InstallStatus}" Margin="0,10,0,0" />
                        <ui:InfoBar Margin="0,10,0,0" Title="Falsche com0com-Version" Severity="Error" IsClosable="False"
                                    IsOpen="{Binding ComPort.HasUnsupportedVersion}"
                                    Message="com0com 3.0 bitte in den Windows-Einstellungen unter „Apps“ deinstallieren und danach die signierte Version 2.2.2.0 installieren." />
                        <WrapPanel Style="{StaticResource ActionRow}">
                            <ui:Button Content="com0com 2.2.2.0 herunterladen" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary"
                                       Command="{Binding ComPort.OpenDownloadCommand}" Margin="0,0,8,0"
                                       Visibility="{Binding ComPort.IsUsable, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:Button Content="Apps-Einstellungen öffnen" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,8,0"
                                       Command="{Binding ComPort.OpenAppsSettingsCommand}"
                                       Visibility="{Binding ComPort.HasUnsupportedVersion, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Erneut prüfen" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding ComPort.RefreshCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Alle Downloads" Icon="{ui:SymbolIcon Open24}" Appearance="Transparent"
                                       Command="{Binding ComPort.OpenDownloadFolderCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Ordner wählen …" Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Transparent"
                                       Command="{Binding ComPort.BrowseCom0comCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ================================================= 2 COM port -->
            <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:StepBadge Number="2" IsDone="{Binding ComPort.PortReady}" VerticalAlignment="Top" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Virtuellen COM-Port anlegen" />
                        <TextBlock Style="{StaticResource StepText}"
                                   Text="Es entsteht ein Port-Paar: Condor schreibt auf den COM-Port, Condor2NMEA liest die Gegenseite. Windows fragt dafür einmal nach Administratorrechten. Der Port bleibt dauerhaft erhalten." />
                        <WrapPanel Style="{StaticResource ActionRow}">
                            <TextBlock Text="COM" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:TextBox Text="{Binding ComPort.ComNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,10,0"
                                        ToolTip="Nummer des COM-Ports, den Condor sehen soll" />
                            <ui:Button Content="Port anlegen" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                       Command="{Binding ComPort.CreatePairCommand}" IsEnabled="{Binding ComPort.IsUsable}" Margin="0,0,12,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24"
                                             Visibility="{Binding ComPort.Busy, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ComPort.ErrorText}" />
                        <ui:InfoBar Margin="0,10,0,0" Title="Port ohne Treiber" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding ComPort.HasInactivePairs}"
                                    Message="Mindestens ein Port ist eingetragen, aber Windows hat den com0com-Treiber nicht geladen (meist falsche Version). Port entfernen, com0com 2.2.2.0 signiert installieren und neu anlegen." />

                        <ItemsControl ItemsSource="{Binding ComPort.Pairs}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="SerialPort24" FontSize="20" Margin="0,0,12,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Body}">
                                                <Run Text="Condor schreibt auf" />
                                                <Run Text="{Binding CondorPort, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  ·  Condor2NMEA liest" />
                                                <Run Text="{Binding AppPort, Mode=OneWay}" FontWeight="SemiBold" />
                                                <LineBreak />
                                                <Run FontSize="12">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Text" Value="● Port aktiv" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusGoodBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DriverActive}" Value="False">
                                                                    <Setter Property="Text" Value="● Treiber nicht geladen – Port funktioniert nicht" />
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ui:Button Content="Verwenden" Margin="0,0,6,0"
                                                           Command="{Binding DataContext.ComPort.UsePairCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Port entfernen" Appearance="Transparent"
                                                           Command="{Binding DataContext.ComPort.RemovePairCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Condor2NMEA liest gerade:" />
                            <Run Text="{Binding Settings.Serial.PortName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ================================================= 3 Condor settings -->
            <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:StepBadge Number="3" IsDone="{Binding UdpIniReady}" VerticalAlignment="Top" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Condor-Ausgaben einschalten" />
                        <TextBlock Style="{StaticResource StepText}">
                            <Run Text="In Condor unter" />
                            <Run Text="Setup → Options → NMEA output" FontWeight="SemiBold" />
                            <Run Text="den Port" />
                            <Run Text="{Binding ComPort.CondorPortName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="wählen. Zusätzlich die UDP-Ausgabe einschalten – dann kommen auch Netto, Lage, G-Last und MacCready an." />
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Condor-Ordner" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:TextBox Grid.Column="1" Text="{Binding Settings.Condor.InstallPath}" PlaceholderText="C:\Condor3" />
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Ordner wählen" Margin="8,0,0,0"
                                       Command="{Binding BrowseCondorCommand}" />
                        </Grid>
                        <WrapPanel Style="{StaticResource ActionRow}">
                            <ui:Button Content="UDP-Ausgabe einrichten" Icon="{ui:SymbolIcon Gauge24}" Appearance="Primary"
                                       Command="{Binding ConfigureUdpIniCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding UdpIniStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="560" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ================================================= 4 fly -->
            <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:StepBadge Number="4" IsDone="{Binding CondorDataReceived}" VerticalAlignment="Top" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Condor starten und losfliegen" />
                        <TextBlock Style="{StaticResource StepText}"
                                   Text="Condor erst nach dem Anlegen des Ports starten, sonst fehlt er in der Liste. Sobald ein Flug läuft, wird dieser Schritt automatisch abgehakt." />
                        <WrapPanel Style="{StaticResource ActionRow}">
                            <ui:Button Content="Brücke starten" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="0,0,12,0"
                                       Command="{Binding StartStopCommand}"
                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding HeroTitle}" FontWeight="SemiBold" />
                        </WrapPanel>
                        <ui:InfoBar Margin="0,12,0,0" Title="Condor neu starten" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding HasCondorWarning}" Message="{Binding CondorWarning}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ================================================= 5 device -->
            <ui:Card Margin="0,0,0,12" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:StepBadge Number="5" IsDone="{Binding DeviceConnected}" VerticalAlignment="Top" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Flugcomputer verbinden" />
                        <TextBlock Style="{StaticResource StepText}">
                            <Run Text="In XCSoar unter" />
                            <Run Text="Konfiguration → Geräte → Gerät A" FontWeight="SemiBold" />
                            <Run Text="Port" />
                            <Run Text="„TCP-Client“" FontWeight="SemiBold" />
                            <Run Text="wählen, diese IP-Adresse und Port 4353 eintragen und als Treiber" />
                            <Run Text="„Condor Soaring Simulator 3“" FontWeight="SemiBold" />
                            <Run Text="einstellen. Der Flugcomputer muss im selben Netzwerk sein." />
                        </TextBlock>
                        <Border Margin="0,14,0,0" Padding="18,12" CornerRadius="8" HorizontalAlignment="Left"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="IP-Adresse dieses PCs" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding PrimaryAddress}" FontSize="24" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding PrimaryAdapter}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Margin="28,0,0,0">
                                    <TextBlock Text="Port" Style="{StaticResource Caption}" />
                                    <TextBlock Text="4353" FontSize="24" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="IP-Adresse kopieren" Appearance="Transparent"
                                           Margin="16,0,0,0" VerticalAlignment="Center"
                                           Command="{Binding CopyTextCommand}" CommandParameter="{Binding PrimaryAddress}" />
                            </StackPanel>
                        </Border>
                        <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding OnlyVirtualAddresses}" IsClosable="False" Severity="Warning"
                                    Title="Kein WLAN- oder LAN-Adapter gefunden"
                                    Message="Es gibt nur Adressen von VPN-Programmen wie Hamachi, Radmin oder ZeroTier. Darüber erreicht das Handy den PC nicht. Verbinde den PC mit demselben WLAN oder Router wie das Handy." />
                        <Expander Margin="0,12,0,0" Header="Andere Adressen dieses PCs" IsExpanded="False"
                                  Visibility="{Binding HasOtherAddresses, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Nur nötig, wenn die Adresse oben nicht funktioniert. Adressen von VPN-Programmen wie Hamachi erreicht das Handy im WLAN nicht." />
                                <ItemsControl ItemsSource="{Binding OtherAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Address}" Width="150" FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Cloudbase: unter Einstellungen › Geräte ein Gerät „Condor“ (TCP) mit dieser IP-Adresse und Port 4354 anlegen – dort kommen zusätzlich Netto, Lage, MacCready, Ballast und Rennstand an. Weitere Geräte oder andere Ports legst du unter Einstellungen → Ausgänge an." />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
