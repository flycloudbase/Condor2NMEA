<Page x:Class="Condor2Nmea.App.Pages.TrafficPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Condor2Nmea.App.Controls"
      xmlns:vm="clr-namespace:Condor2Nmea.App.ViewModels"
      Title="Verkehr"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Verkehr" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="{Binding TrafficInfo}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="110"
                                  ItemsSource="{x:Static vm:MainViewModel.RadarRangeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding RadarRangeKm}" />
                        <TextBlock Text="Radar (Norden oben)" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <c:RadarView Grid.Row="1" Margin="0,12" Targets="{Binding RadarTargets}" RangeKm="{Binding RadarRangeKm}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FF8A65" Margin="0,0,6,0" />
                        <TextBlock Text="höher" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                        <Ellipse Width="10" Height="10" Fill="#FFD54F" Margin="0,0,6,0" />
                        <TextBlock Text="gleiche Höhe (±50 m)" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                        <Ellipse Width="10" Height="10" Fill="#81C784" Margin="0,0,6,0" />
                        <TextBlock Text="tiefer" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <DataGrid ItemsSource="{Binding Traffic}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None"
                              Visibility="{Binding HasTraffic, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CN" Binding="{Binding Cn}" Width="60" />
                            <DataGridTextColumn Header="Pilot" Binding="{Binding Pilot}" Width="2*" />
                            <DataGridTextColumn Header="Flugzeug" Binding="{Binding Plane}" Width="1.5*" />
                            <DataGridTextColumn Header="Entf." Binding="{Binding Distance}" Width="75" />
                            <DataGridTextColumn Header="Peilung" Binding="{Binding Bearing}" Width="70" />
                            <DataGridTextColumn Header="Höhe rel." Binding="{Binding Vertical}" Width="80" />
                            <DataGridTextColumn Header="Fahrt" Binding="{Binding Speed}" Width="85" />
                            <DataGridTextColumn Header="Vario" Binding="{Binding Vario}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasTraffic, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="People24" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="Kein Verkehr in Reichweite" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Andere Flugzeuge erscheinen hier und als FLARM-Ziele im Flugcomputer, sobald du online im Multiplayer fliegst."
                                   Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="340" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
