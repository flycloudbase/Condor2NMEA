<Page x:Class="Condor2Nmea.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Übersicht"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,36" MaxWidth="1240">
            <TextBlock Style="{StaticResource PageTitle}" Text="Übersicht" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Condor2NMEA sammelt die Daten aus Condor 3 und gibt sie als NMEA an deinen Flugcomputer weiter." />

            <!-- ======================================================= hero -->
            <ui:Card Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="18" Height="18" Fill="{Binding HeroBrush}" VerticalAlignment="Top" Margin="0,8,18,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding HeroTitle}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding HeroText}" Style="{StaticResource Body}" Margin="0,4,24,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ui:Button Content="Starten" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                   Command="{Binding StartStopCommand}" MinWidth="130" Height="40"
                                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Content="Stoppen" Icon="{ui:SymbolIcon Stop24}"
                                   Command="{Binding StartStopCommand}" MinWidth="130" Height="40"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar Margin="0,12,0,0" Title="Kollisionswarnung" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasCollisionWarning}" Message="{Binding CollisionText}" />
            <ui:InfoBar Margin="0,12,0,0" Title="Condor neu starten" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding HasCondorWarning}" Message="{Binding CondorWarning}" />

            <!-- ======================================================= instruments -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Flugdaten" />
            <ItemsControl ItemsSource="{Binding Instruments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,10,10" Padding="18,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource BigValue}" />
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                                               Margin="6,0,0,6" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ======================================================= task -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Aufgabe" />
            <ui:Card Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Map24" FontSize="22" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding TaskTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TaskStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding TaskPoints}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding Sector}" Style="{StaticResource Caption}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- ======================================================= sources -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Eingänge aus Condor" />
            <ItemsControl ItemsSource="{Binding SourceCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,10,10" Padding="18,16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Rate}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="0,10,0,0" Opacity="0.75" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ======================================================= outputs -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Ausgänge zum Flugcomputer" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,-4,0,10"
                       Text="Starte die Brücke, um die Ausgänge zu sehen. Ausgänge legst du in den Einstellungen an."
                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding OutputCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,10,10" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Router24" FontSize="26" Margin="0,0,16,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Body}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Instruction}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Address}" FontSize="20" FontFamily="Cascadia Mono, Consolas"
                                               VerticalAlignment="Center" Margin="16,0,10,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="Adresse kopieren" Appearance="Transparent"
                                               Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Address}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
