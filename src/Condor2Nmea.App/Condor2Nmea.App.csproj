<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Condor2NMEA</AssemblyName>
    <!-- 32-bit like Condor: Condor's NaviCon.dll (task coordinates) is 32-bit and only loads into a 32-bit process -->
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>Condor2Nmea.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>Condor2NMEA</Title>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Condor2Nmea.Runtime\Condor2Nmea.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>
</Project>
